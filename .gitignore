# 密钥
.env

# 产物 / 缓存
data/audio/
data/cache/
data/images/
data/material/
data/preview/
data/segments/
data/slides/
data/tmp/
data/output/
# 曲子本身不入库（3.6MB 音频），但来源与许可留痕要入库
# （data/bgm/来源与许可.md 记了曲名/作者/许可类型/混音参数，发布举证用）
data/bgm/**/*.mp3
!data/bgm/.gitkeep
# 影视切片素材（体积大 + 第三方版权内容），只留索引和许可留痕入库
data/clips/**/*.mp4
data/clips/**/*.mov
data/clips/**/*.mkv
data/clips/**/*.avi

# python
.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.claude/
.opencode/
