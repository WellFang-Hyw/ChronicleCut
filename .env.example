# ============================================================
#  API Keys —— 这个文件会被 .gitignore 忽略，不要提交
#  复制成 .env 即可；已有的真实环境变量优先级更高，不会被覆盖。
#
#  本机现状：DEEPSEEK_API_KEY / MINIMAX_API_KEY 已经写在
#  Windows 的「系统级环境变量」里，正常情况下不用这个文件。
#  但注意：Hermes / 某些从图形界面启动的终端里，子进程可能继承不到
#  这些变量 —— 项目因此内置了「读注册表」兜底（见 src/hsg/config.py
#  的 _registry_env），所以三种途径任意一种有值就能跑：
#      1) 系统环境变量（推荐，已配好）
#      2) 这个 .env 文件
#      3) Windows 注册表 Machine/User 环境变量（自动兜底）
# ============================================================

# ---- 文本大模型：DeepSeek（写稿 / 史实审校）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 语音合成：MiniMax（TTS）----
MINIMAX_API_KEY=
